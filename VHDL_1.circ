<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="3.8.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution or Logisim.
  <lib desc="#Wiring" name="0">
    <tool name="Splitter">
      <a name="facing" val="west"/>
      <a name="fanout" val="8"/>
      <a name="incoming" val="8"/>
    </tool>
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
    <tool name="Tunnel"/>
    <tool name="Constant"/>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="Task1_Logic"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
  </toolbar>

  <!-- Task 1: 4-Input AND / OR Logic -->
  <circuit name="Task1_Logic">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Task1_Logic"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(120,100)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="a"/>
    </comp>
    <comp lib="0" loc="(120,140)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="b"/>
    </comp>
    <comp lib="0" loc="(120,180)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="c"/>
    </comp>
    <comp lib="0" loc="(120,220)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="d"/>
    </comp>
    <comp lib="1" loc="(280,120)" name="AND Gate">
      <a name="inputs" val="4"/>
      <a name="label" val="AND4"/>
    </comp>
    <comp lib="1" loc="(280,220)" name="OR Gate">
      <a name="inputs" val="4"/>
      <a name="label" val="OR4"/>
    </comp>
    <comp lib="0" loc="(360,120)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="out1"/>
      <a name="output" val="true"/>
    </comp>
    <comp lib="0" loc="(360,220)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="out2"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(120,100)" to="(180,100)"/>
    <wire from="(180,100)" to="(180,200)"/>
    <wire from="(180,100)" to="(230,100)"/>
    <wire from="(180,200)" to="(230,200)"/>
    <wire from="(120,140)" to="(190,140)"/>
    <wire from="(190,110)" to="(190,140)"/>
    <wire from="(190,110)" to="(230,110)"/>
    <wire from="(190,140)" to="(190,210)"/>
    <wire from="(190,210)" to="(230,210)"/>
    <wire from="(120,180)" to="(200,180)"/>
    <wire from="(200,130)" to="(200,180)"/>
    <wire from="(200,130)" to="(230,130)"/>
    <wire from="(200,180)" to="(200,230)"/>
    <wire from="(200,230)" to="(230,230)"/>
    <wire from="(120,220)" to="(210,220)"/>
    <wire from="(210,140)" to="(210,220)"/>
    <wire from="(210,140)" to="(230,140)"/>
    <wire from="(210,220)" to="(210,240)"/>
    <wire from="(210,240)" to="(230,240)"/>
    <wire from="(280,120)" to="(360,120)"/>
    <wire from="(280,220)" to="(360,220)"/>
  </circuit>

  <!-- Task 2: 8-to-1 Multiplexer -->
  <circuit name="Task2_MUX8_1">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Task2_MUX8_1"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(120,80)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="a"/></comp>
    <comp lib="0" loc="(120,110)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="b"/></comp>
    <comp lib="0" loc="(120,140)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="c"/></comp>
    <comp lib="0" loc="(120,170)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="d"/></comp>
    <comp lib="0" loc="(120,200)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="e"/></comp>
    <comp lib="0" loc="(120,230)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="f"/></comp>
    <comp lib="0" loc="(120,260)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="g"/></comp>
    <comp lib="0" loc="(120,290)" name="Pin"><a name="appearance" val="classic"/><a name="label" val="h"/></comp>
    <comp lib="0" loc="(260,280)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="north"/>
      <a name="label" val="ch"/>
      <a name="width" val="3"/>
    </comp>
    <comp lib="2" loc="(280,180)" name="Multiplexer">
      <a name="select" val="3"/>
    </comp>
    <comp lib="0" loc="(350,180)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="data"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(120,80)" to="(200,80)"/><wire from="(200,80)" to="(200,140)"/><wire from="(200,140)" to="(240,140)"/>
    <wire from="(120,110)" to="(210,110)"/><wire from="(210,110)" to="(210,150)"/><wire from="(210,150)" to="(240,150)"/>
    <wire from="(120,140)" to="(220,140)"/><wire from="(220,140)" to="(220,160)"/><wire from="(220,160)" to="(240,160)"/>
    <wire from="(120,170)" to="(240,170)"/>
    <wire from="(120,200)" to="(220,200)"/><wire from="(220,180)" to="(220,200)"/><wire from="(220,180)" to="(240,180)"/>
    <wire from="(120,230)" to="(210,230)"/><wire from="(210,190)" to="(210,230)"/><wire from="(210,190)" to="(240,190)"/>
    <wire from="(120,260)" to="(200,260)"/><wire from="(200,200)" to="(200,260)"/><wire from="(200,200)" to="(240,200)"/>
    <wire from="(120,290)" to="(190,290)"/><wire from="(190,210)" to="(190,290)"/><wire from="(190,210)" to="(240,210)"/>
    <wire from="(260,220)" to="(260,280)"/>
    <wire from="(280,180)" to="(350,180)"/>
  </circuit>

  <!-- Task 3: 7-Segment Display for Letters a,b,c,d,f,g -->
  <circuit name="Task3_LED_Letters">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Task3_LED_Letters"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(120,120)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="en"/>
    </comp>
    <comp lib="0" loc="(120,180)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="dat"/>
      <a name="width" val="4"/>
    </comp>
    <comp lib="4" loc="(180,170)" name="ROM">
      <a name="addrWidth" val="4"/>
      <a name="contents">addr/data: 4 8
ee 3e 9c 7a 8e f6 f6 0
0 0 ee 3e 9c 7a 0 8e
</a>
      <a name="dataWidth" val="8"/>
    </comp>
    <comp lib="5" loc="(520,140)" name="7-Segment Display"/>
    <comp lib="0" loc="(450,260)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="display"/>
      <a name="output" val="true"/>
      <a name="width" val="8"/>
    </comp>
    <wire from="(120,180)" to="(180,180)"/>
    <wire from="(420,220)" to="(450,260)"/>
  </circuit>

  <!-- Task 4: 25-Person Voting Machine -->
  <circuit name="Task4_Vote25">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Task4_Vote25"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(140,160)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="vt"/>
      <a name="width" val="25"/>
    </comp>
    <comp lib="3" loc="(260,160)" name="BitAdder">
      <a name="width" val="25"/>
    </comp>
    <comp lib="0" loc="(280,200)" name="Constant">
      <a name="value" val="0xd"/>
      <a name="width" val="5"/>
    </comp>
    <comp lib="3" loc="(360,170)" name="Comparator">
      <a name="mode" val="unsigned"/>
      <a name="width" val="5"/>
    </comp>
    <comp lib="1" loc="(430,170)" name="OR Gate">
      <a name="inputs" val="2"/>
    </comp>
    <comp lib="0" loc="(490,170)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="result"/>
      <a name="output" val="true"/>
    </comp>
    <wire from="(140,160)" to="(220,160)"/>
    <wire from="(260,160)" to="(320,160)"/>
    <wire from="(280,200)" to="(300,200)"/>
    <wire from="(300,180)" to="(300,200)"/>
    <wire from="(300,180)" to="(320,180)"/>
    <wire from="(360,160)" to="(380,160)"/>
    <wire from="(360,170)" to="(380,170)"/>
    <wire from="(430,170)" to="(490,170)"/>
  </circuit>

  <!-- Task 5: 13-Bit '1's Counter + 7-Segment Hex Display with Enable -->
  <circuit name="Task5_Vote13_LED">
    <a name="appearance" val="logisim_evolution"/>
    <a name="circuit" val="Task5_Vote13_LED"/>
    <a name="circuitnamedboxfixedsize" val="true"/>
    <a name="simulationFrequency" val="1.0"/>
    <comp lib="0" loc="(120,100)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="en"/>
    </comp>
    <comp lib="0" loc="(120,180)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="label" val="vt"/>
      <a name="width" val="13"/>
    </comp>
    <comp lib="3" loc="(220,180)" name="BitAdder">
      <a name="width" val="13"/>
    </comp>
    <comp lib="4" loc="(260,170)" name="ROM">
      <a name="addrWidth" val="4"/>
      <a name="contents">addr/data: 4 8
fc 60 da f2 66 b6 be e0
fe f6 ee 3e 9c 7a 9e 8e
</a>
      <a name="dataWidth" val="8"/>
    </comp>
    <comp lib="2" loc="(560,200)" name="Multiplexer">
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(510,190)" name="Constant">
      <a name="value" val="0x0"/>
      <a name="width" val="8"/>
    </comp>
    <comp lib="0" loc="(620,200)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="label" val="display"/>
      <a name="output" val="true"/>
      <a name="width" val="8"/>
    </comp>
    <wire from="(120,180)" to="(180,180)"/>
    <wire from="(220,180)" to="(260,180)"/>
    <wire from="(500,220)" to="(530,210)"/>
    <wire from="(510,190)" to="(530,190)"/>
    <wire from="(120,100)" to="(540,100)"/>
    <wire from="(540,100)" to="(540,220)"/>
    <wire from="(560,200)" to="(620,200)"/>
  </circuit>
</project>
